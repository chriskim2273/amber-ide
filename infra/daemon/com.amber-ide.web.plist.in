<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh substitutes __AMBER_BIN__ with the installed path. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amber-ide.web</string>
    <!-- Binds 127.0.0.1 ONLY; reach it from a phone via `tailscale serve`. -->
    <key>ProgramArguments</key>
    <array>
        <string>__AMBER_BIN__</string>
        <string>web</string>
        <string>--port</string>
        <string>7717</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <!-- launchd has no journal, so the desktop app's "log" panel reads this
         file (spec 2026-08-22 §12.2 records the Linux/macOS asymmetry:
         `journalctl --user -u amber-web.service` has no macOS equivalent). -->
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/amber-web.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/amber-web.log</string>
</dict>
</plist>
